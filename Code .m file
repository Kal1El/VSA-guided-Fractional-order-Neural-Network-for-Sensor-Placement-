function [row,sol]=run_exact_lex_milp(M,c)
% EXACT INTEGER BENCHMARK, INDEPENDENT OF THE FIVE HEURISTICS.
% Stage 1: globally minimize PMU count. Stage 2: fix that count and
% globally minimize current-channel assignments. The status OPTIMAL
% requires BOTH intlinprog stages to be certified (exitflag == 1).
% If a time limit is reached, we may retain a feasible INCUMBENT but
% NEVER call it globally optimal. Missing Optimization Toolbox gives NaNs.
row=table(string(M.name),string(M.scenario),M.cap,NaN,NaN, ...
    false,false,string('NOT_SOLVED'),NaN,NaN,0, ...
    string(''),string(''), ...
    'VariableNames',{'System','Scenario','Channels','MILP_PMUs', ...
    'MILP_Channels','PMUOptimal','LexOptimal','MILPStatus', ...
    'Stage1ExitFlag','Stage2ExitFlag','MILPRuntimeSec', ...
    'MILP_PMUBuses','MILP_ChannelAssignments'});
sol=struct('x',[],'w',[],'Y',[]);
if exist('intlinprog','file')~=2 && exist('intlinprog','file')~=6
    row.MILPStatus="UNAVAILABLE_INTLINPROG";
    warning('intlinprog missing: global-optimality matches cannot be claimed.');
    return;
end
clock=tic;
try
    [A,b,lb,ub,total,n,K]=build_exact_pmu_milp(M);
    f1=zeros(total,1);f1(1:n)=1;
    f2=zeros(total,1);f2(n+(1:K))=1;
    options=optimoptions('intlinprog','Display',c.milpDisplay, ...
        'MaxTime',c.milpTimeLimitSec, ...
        'RelativeGapTolerance',0,'AbsoluteGapTolerance',0);
    [v1,~,ef1]=intlinprog(f1,(1:total)',A,b,[],[],lb,ub,options);
    row.Stage1ExitFlag=ef1;
    if isempty(v1)
        row.MILPStatus="NO_FEASIBLE_INCUMBENT";
        row.MILPRuntimeSec=toc(clock);return;
    end
    s1=milp_to_solution(v1,M,n,K);
    if ~milp_solution_valid(M,s1)
        row.MILPStatus="INVALID_STAGE1_INCUMBENT";
        row.MILPRuntimeSec=toc(clock);
        warning('MILP stage 1 failed independent observability validation.');
        return;
    end
    s=s1;pmuCount=nnz(s1.x);
    row.PMUOptimal=(ef1==1);
    % Second objective conditional on the feasible stage-1 PMU cardinality.
    % If stage 1 did not prove its optimum, even a solved second stage
    % CANNOT establish global lexicographic optimality.
    Aeq=sparse(ones(1,n),1:n,ones(1,n),1,total);
    [v2,~,ef2]=intlinprog(f2,(1:total)',A,b,Aeq,pmuCount,lb,ub,options);
    row.Stage2ExitFlag=ef2;
    stage2Valid=false;
    if ~isempty(v2)
        s2=milp_to_solution(v2,M,n,K);
        if milp_solution_valid(M,s2) && nnz(s2.x)==pmuCount && ...
                nnz(s2.Y)<=nnz(s1.Y)
            s=s2;
            stage2Valid=true;
        else
            row.MILPStatus="INVALID_STAGE2_INCUMBENT";
            % Keep the original verified feasible solution; no stage-2 proof.
            ef2=NaN;
        end
    end
    row.LexOptimal=row.PMUOptimal && (ef2==1) && stage2Valid && ...
        milp_solution_valid(M,s) && nnz(s.x)==pmuCount;
    row.MILP_PMUs=nnz(s.x);
    row.MILP_Channels=nnz(s.Y);
    row.MILP_PMUBuses=string(strtrim(sprintf('%d ',M.ids(s.x))));
    row.MILP_ChannelAssignments=assignment_text(M,s.Y);
    if row.LexOptimal
        row.MILPStatus="OPTIMAL_BOTH_OBJECTIVES";
    elseif row.PMUOptimal
        row.MILPStatus="PMU_OPTIMAL_CHANNEL_UNPROVEN";
    else
        row.MILPStatus="FEASIBLE_NOT_PROVEN_OPTIMAL";
    end
    sol=s;
catch err
    row.MILPStatus="ERROR_"+string(err.identifier);
    warning('MILP benchmark error: %s',err.message);
end
row.MILPRuntimeSec=toc(clock);
end

function [A,b,lb,ub,total,n,K]=build_exact_pmu_milp(M)
% Exact MILP for the same model checked by observation(M,cov):
% - Simple: at least one PMU voltage or measured incoming branch;
% - N-1: at least two distinct PMU sources for every bus;
% - ZIB: direct observation plus finite-round Boolean KCL closure.
%
% The ZIB model is fully layered. Its inference may only use the PREVIOUS
% layer, preventing circular/self-supporting KCL observability, which is a
% known pitfall of unlayered binary auxiliary constraints.
n=M.n;K=M.arcN;
x=(1:n)';y=(n+(1:K))';
useZIB=strcmp(M.scenario,'ZIB');
if useZIB
    T=n; % each useful synchronous inference observes >= 1 new bus.
    % q pairs (KCL cluster index, inferred target, other cluster members)
    tgt=zeros(0,1); other=cell(0,1);
    for k=1:numel(M.clusters)
        cluster=M.clusters{k}(:);
        if numel(cluster)<2,continue;end
        for j=1:numel(cluster)
            tgt(end+1,1)=cluster(j); %#ok<AGROW>
            other{end+1,1}=cluster(cluster~=cluster(j)); %#ok<AGROW>
        end
    end
    qCount=numel(tgt);
    sIdx=n+K+reshape((1:n*(T+1))',n,T+1);
    qIdx=n+K+n*(T+1)+reshape((1:qCount*T)',qCount,T);
    total=n+K+n*(T+1)+qCount*T;
else
    T=0;qCount=0;tgt=[];other={};sIdx=[];qIdx=[];
    total=n+K;
end
lb=zeros(total,1);ub=ones(total,1);
if useZIB,lb(sIdx(:,end))=1;end
% Sparse row assembler: each inequality sum_j a_ij v_j <= b_i.
riBlocks=cell(0,1);ciBlocks=cell(0,1);vaBlocks=cell(0,1);
b=zeros(0,1);nr=0;
for arc=1:K
    % A channel can exist only if its originating PMU exists: y_ij<=x_i
    add_ub([y(arc);x(M.arcFrom(arc))],[1;-1],0);
end
for bus=1:n
    arcs=M.out{bus};
    if ~isempty(arcs)
        add_ub([y(arcs(:));x(bus)],[ones(numel(arcs),1);-M.cap],0);
    end
end
if ~useZIB
    for bus=1:n
        inc=M.in{bus};
        add_ub([x(bus);y(inc(:))],-ones(numel(inc)+1,1),-M.required);
    end
else
    % s(bus,0) is EXACTLY the OR of own PMU and all incoming channels.
    for bus=1:n
        inc=M.in{bus};s=sIdx(bus,1);
        add_ub([x(bus);s],[1;-1],0);
        for arc=inc(:)'
            add_ub([y(arc);s],[1;-1],0);
        end
        add_ub([s;x(bus);y(inc(:))],[1;-ones(numel(inc)+1,1)],0);
    end
    qForTarget=cell(n,1);
    for j=1:qCount
        qForTarget{tgt(j)}(end+1,1)=j;
    end
    for t=1:T
        prev=sIdx(:,t); nxt=sIdx(:,t+1);
        % q_{cluster,target,t} == AND(all other observed prev-layer buses)
        for z=1:qCount
            q=qIdx(z,t);oth=other{z};
            for bb=oth(:)'
                add_ub([q;prev(bb)],[1;-1],0);
            end
            add_ub([prev(oth);q],[ones(numel(oth),1);-1],numel(oth)-1);
            add_ub([q;nxt(tgt(z))],[1;-1],0);
        end
        for bus=1:n
            relevant=qForTarget{bus};
            % s(bus,t) <=> s(bus,t-1) OR any inferred q_{bus,t}.
            add_ub([prev(bus);nxt(bus)],[1;-1],0);
            add_ub([nxt(bus);prev(bus);qIdx(relevant,t)], ...
                [1;-ones(numel(relevant)+1,1)],0);
        end
    end
end
if nr>0
    ri=vertcat(riBlocks{:});ci=vertcat(ciBlocks{:});va=vertcat(vaBlocks{:});
else
    ri=zeros(0,1);ci=zeros(0,1);va=zeros(0,1);
end
A=sparse(ri,ci,va,nr,total);
assert(numel(b)==nr && size(A,2)==total,'Malformed MILP sparse model');

    function add_ub(indices,values,rhs)
        indices=indices(:);values=values(:);
        assert(numel(indices)==numel(values));
        mask=values~=0;
        nr=nr+1;
        rows=repmat(nr,nnz(mask),1);
        riBlocks{nr,1}=rows;
        ciBlocks{nr,1}=indices(mask);
        vaBlocks{nr,1}=values(mask);
        b(nr,1)=rhs;
    end
end

function s=milp_to_solution(v,M,n,K)
x=logical(round(v(1:n))>=1);
w=double(round(v(n+(1:K)))>=1);
Y=false(n,n);
for arc=1:K
    if w(arc)>0
        Y(M.arcFrom(arc),M.arcTo(arc))=true;
    end
end
s=struct('x',x,'w',w,'Y',Y);
end

function valid=milp_solution_valid(M,s)
valid=false;
if isempty(s.x),return;end
if any(sum(s.Y,2)>M.cap) || any(any(s.Y(~s.x,:))) || ...
        any(any(s.Y & ~logical(M.Adj)))
    return;
end
cov=double(s.x)+sum(s.Y,1)';
valid=all(observation(M,cov));
end

function D=attach_milp(D,Reference,countCol,channelCol)
% Join the independently computed certificate onto nominal or random rows.
% NaN = unknown when MILP did not prove optimality (NOT a failed hit).
if isempty(D),return;end
D=outerjoin(D,Reference,'Keys',{'System','Scenario','Channels'}, ...
    'MergeKeys',true,'Type','left');
if strcmp(countCol,'NominalPMUs')
    pmuName='NominalPMUGlobalMatch';lexName='NominalLexGlobalMatch';
else
    pmuName='PMUGlobalMatch';lexName='LexGlobalMatch';
end
D.(pmuName)=NaN(height(D),1);D.(lexName)=NaN(height(D),1);
for j=1:height(D)
    if D.PMUOptimal(j)
        D.(pmuName)(j)=double(D.Feasible(j) && ...
            D.(countCol)(j)==D.MILP_PMUs(j));
    end
    if D.LexOptimal(j)
        D.(lexName)(j)=double(D.Feasible(j) && ...
            D.(countCol)(j)==D.MILP_PMUs(j) && ...
            D.(channelCol)(j)==D.MILP_Channels(j));
    end
end
end


function selftest()
% Five-leaf star: a central 2-channel PMU cannot cover five leaves.
M=struct('name','star','n',6,'ids',(1:6)','Adj',sparse(6,6), ...
    'clusters',{{}},'scenario','Simple','required',1,'cap',2, ...
    'arcFrom',[],'arcTo',[],'arcN',0,'in',{{}},'out',{{}});
for i=2:6,M.Adj(1,i)=1;M.Adj(i,1)=1;end
[M.arcFrom,M.arcTo]=find(M.Adj);M.arcN=numel(M.arcFrom);
M.in=cell(M.n,1);M.out=cell(M.n,1);
for k=1:M.arcN
    M.out{M.arcFrom(k)}(end+1)=k;
    M.in{M.arcTo(k)}(end+1)=k;
end
x=logical([1;0;0;0;0;0]);
M.cap=2;
assert(~decode(M,x,ones(M.arcN,1)), ...
    'Two-channel central star incorrectly observable.');
M.cap=5;
assert(decode(M,x,ones(M.arcN,1)), ...
    'Five-channel central star should observe five neighbours.');
for cap=2:5
    M.cap=cap;
    for mask=0:2^M.n-1
        z=logical(bitget(uint16(mask),1:M.n)');
        [~,~,~,Y]=decode(M,z,ones(M.arcN,1));
        assert(all(sum(Y,2)<=cap));
        assert(~any(any(Y(~z,:))));
        assert(~any(any(Y & ~logical(M.Adj))));
    end
end
M.cap=4;
assert(decode(M,true(M.n,1),ones(M.arcN,1)));
assert(better(3,10,4,1));
assert(better(3,6,3,7));
c=config('smoke');c.showFigures=false;
x0=.3+.4*rand(M.n,1);w0=.3+.4*rand(M.arcN,1);
for alpha=[.8 1]
    N=run_neural(M,c,alpha,x0,w0);
    S=repair_archive(M,N.archive,c);
    d=details(M,S);assert(~isempty(S) && d.ok,'Neural repair failure.');
end
X=rand(M.n+M.arcN,c.population)<.5;
for algo={'BPSO','BGWO','GA'}
    rng(1234,'twister');
    N=run_population(M,c,algo{1},X);
    assert(N.evals==c.population*(c.generations+1),'Native evaluation mismatch.');
    assert(all(isfinite(N.rawTrace)),'Bad native trace.');
    S=repair_archive(M,N.archive,c,N.bestNative);
    d=details(M,S);assert(~isempty(S) && d.ok,'Metaheuristic repair failure.');
end
% VSA search: Gaussian proposals, decreasing inverse-gamma radius,
% common training starts and independent shortlisted polished reranking.
c.vsaIterations=3;c.vsaPopulation=4;c.vsaCheapStarts=1;
c.vsaPolishStarts=1;c.vsaPolishTop=3;
[aa,H,C,~]=vsa_alpha(M,c,123);
assert(aa>=c.alphaLo && aa<=c.alphaHi && ...
    any(H.Stage=="VSA") && any(H.Stage=="POLISH") && ...
    all(C.Alpha>=c.alphaLo & C.Alpha<=c.alphaHi));
T=H(H.Stage=="VSA",:);
assert(all(diff(T.Radius(T.CandidateIndex==1))<=1e-12), ...
    'VSA search radius did not shrink.');
if exist('intlinprog','file')==2 || exist('intlinprog','file')==6
    % Independent exact PMU-count check against exhaustive PMU masks for
    % the tiny star test (not part of the actual study).
    for cap=[2 5]
        M.cap=cap; M.scenario='Simple';M.required=1;
        [row,~]=run_exact_lex_milp(M,c);
        if row.PMUOptimal
            counts=[];
            for mask=0:2^M.n-1
                bits=logical(bitget(uint16(mask),1:M.n)');
                if decode(M,bits,ones(M.arcN,1))
                    counts(end+1)=nnz(bits); %#ok<AGROW>
                end
            end
            assert(row.MILP_PMUs==min(counts),'MILP count disagrees with brute PMU masks.');
        end
    end
else
    fprintf('MILP selftest skipped: Optimization Toolbox intlinprog is unavailable.\n');
end
% Regression: a per-capacity summary must first receive MILP match flags.
% One verified exact match and one nonmatching run should give 50% hits.
D=table(repmat(string('star'),2,1),repmat(string('Simple'),2,1), ...
    [2;2],repmat(string('FORNN'),2,1),[3;4],[2;3], ...
    [true;true],[0.5;0.7], ...
    'VariableNames',{'System','Scenario','Channels','Method', ...
    'FinalPMUs','AssignedChannels','Feasible','RuntimeSec'});
Ref=table(string('star'),string('Simple'),2,3,2,true,true, ...
    'VariableNames',{'System','Scenario','Channels', ...
    'MILP_PMUs','MILP_Channels','PMUOptimal','LexOptimal'});
Checked=attach_milp(D,Ref,'FinalPMUs','AssignedChannels');
Summary=make_simple_summary(Checked);
assert(isequal(Summary.PMUGlobalHitPct,50) && ...
    isequal(Summary.LexGlobalHitPct,50), ...
    'MILP-matched per-capacity summary regression failed.');
% Without a mathematical certificate the corresponding hit rates are unknown.
Ref.PMUOptimal=false;Ref.LexOptimal=false;
